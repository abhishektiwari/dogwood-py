@id("hourly_transfer_quota")
permit (
    principal,
    action == Agent::Action::"Transfer",
    resource
)
when temporal {
    exists (n: Long). (
        (count for (t: Timepoint). where (
            formerly within 1h (
                Agent::Action::"Transfer"::request{
                    input.user: context.input.user
                }
                && tp(t)
            )
        )) == n
        && n < 3
    )
};
