@id("daily_transfer_limit")
permit (
    principal,
    action == Agent::Action::"Transfer",
    resource
)
when temporal {
    exists (total: Long). (
        (sum_within(
            amount,
            1d,
            Agent::Action::"Transfer"::request{
                input.user: context.input.user,
                input.amount: amount
            }
        )) == total
        && total <= 50
    )
};
