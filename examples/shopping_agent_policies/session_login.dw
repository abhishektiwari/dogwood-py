@id("shopping_session_login_required")
@hint("run login before checkout")
permit (
    principal,
    action in [Agent::Action::"ShoppingTool"],
    resource
)
when {
    context.input.tool != "login"
}
when temporal {
    formerly within 1h (
        Agent::Action::"Login"::request{
            input.input.user: context.input.input.user,
            input.input.session_id: context.input.input.session_id
        }
    )
};
