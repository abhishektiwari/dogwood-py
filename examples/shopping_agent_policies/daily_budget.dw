@id("shopping_daily_budget")
@hint("either daily budget is exceeded or cart total needs to be reduced so today's successful orders stay within daily budget")
permit (
    principal,
    action == Agent::Action::"CheckoutCart",
    resource
)
when temporal {
    exists (total: Long). (
        (sum_within(
            amount,
            1d,
            Agent::Action::"CheckoutCart"::request{
                input.input.user: context.input.input.user,
                input.input.amount: amount,
                input.input.status: "completed"
            }
        )) == total
        && total <= 50
    )
};
