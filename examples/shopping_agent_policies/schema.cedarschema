namespace Agent {
  type ShoppingToolArgs = {
    user: String,
    session_id: String,
    cart_id: String,
    item_id: String,
    category: String,
    amount: Long,
    quantity: Long,
    risk: Long,
    status: String
  };

  type ShoppingToolInput = {
    tool: String,
    input: ShoppingToolArgs,
    toolUseId: String
  };

  entity Gateway;

  entity OAuthUser;

  action "ShoppingTool" appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: {
      input: ShoppingToolInput
    }
  };

  action "GrantSession" in [Action::"ShoppingTool"] appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: {
      input: ShoppingToolInput
    }
  };

  action "RevokeSession" in [Action::"ShoppingTool"] appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: {
      input: ShoppingToolInput
    }
  };

  action "Login" in [Action::"ShoppingTool"] appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: {
      input: ShoppingToolInput
    }
  };

  action "ApproveCheckout" in [Action::"ShoppingTool"] appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: {
      input: ShoppingToolInput
    }
  };

  action "ApproveStepUp" in [Action::"ShoppingTool"] appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: {
      input: ShoppingToolInput
    }
  };

  action "GetShoppingCart" in [Action::"ShoppingTool"] appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: {
      input: ShoppingToolInput
    }
  };

  action "ListProducts" in [Action::"ShoppingTool"] appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: {
      input: ShoppingToolInput
    }
  };

  action "AddToCart" in [Action::"ShoppingTool"] appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: {
      input: ShoppingToolInput
    }
  };

  action "RemoveFromCart" in [Action::"ShoppingTool"] appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: {
      input: ShoppingToolInput
    }
  };

  action "CheckoutCart" in [Action::"ShoppingTool"] appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: {
      input: ShoppingToolInput
    }
  };
}
