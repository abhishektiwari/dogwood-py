@id("shopping_session_access_not_revoked")
@hint("access required: run grant first")
permit (
    principal,
    action in [Agent::Action::"ShoppingTool"],
    resource
)
when {
    context.input.tool != "grant_session" &&
    context.input.tool != "revoke_session"
}
when temporal {
    (
        !Agent::Action::"RevokeSession"::request{
            input.input.user: context.input.input.user,
            input.input.session_id: context.input.input.session_id
        }
        since within 1h
        Agent::Action::"GrantSession"::request{
            input.input.user: context.input.input.user,
            input.input.session_id: context.input.input.session_id
        }
    )
};
